{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC (Ninja Multi-Config)",
      "description": "Run from a VS x64 Native Tools / Developer shell so cl.exe is on PATH. Point CMAKE_PREFIX_PATH (or Qt6_DIR) at your Qt MSVC kit.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_CXX_COMPILER": "cl"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc", "configuration": "Debug" }
  ]
}
